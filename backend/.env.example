# Backend environment — copy to backend/.env and fill in.
# Required for the Test Endpoint page (LLM-based PII detection).
GROQ_API_KEY=

# Optional Clerk login. Clerk authenticates identity; WatchTower still authorizes
# access by matching the Clerk user's email to an approved local user.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
CLERK_ALLOWED_EMAIL_DOMAINS=
